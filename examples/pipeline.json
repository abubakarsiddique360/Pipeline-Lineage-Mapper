{
  "name": "nightly-revenue",
  "nodes": [
    {
      "id": "raw_events",
      "kind": "source",
      "owner": "data-platform",
      "writes": ["raw.events"],
      "minutes": 2
    },
    {
      "id": "crm_sync",
      "kind": "source",
      "owner": "crm-team",
      "writes": ["raw.crm"],
      "minutes": 3
    },
    {
      "id": "clean_events",
      "owner": "data-platform",
      "reads": ["raw.events"],
      "writes": ["stg.events"],
      "minutes": 4
    },
    {
      "id": "build_customers",
      "owner": "crm-team",
      "reads": ["raw.crm"],
      "writes": ["dim.customers"],
      "minutes": 6
    },
    {
      "id": "fact_orders",
      "owner": "data-platform",
      "reads": ["stg.events", "dim.customers"],
      "writes": ["fact.orders"],
      "minutes": 9
    },
    {
      "id": "forecast",
      "owner": "ml-team",
      "reads": ["fact.orders"],
      "writes": ["ml.forecast"],
      "minutes": 12
    },
    {
      "id": "report_daily",
